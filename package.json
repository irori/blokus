{
  "name": "blokus",
  "version": "1.0.0",
  "description": "Browser-based Blokus Duo game",
  "type": "module",
  "scripts": {
    "build": "esbuild src/blokus.ts css/blokus.css --bundle --target=es2017 --format=esm --outdir=dist \"--entry-names=[name]\" --charset=utf8 --sourcemap --minify --supported:nesting=false",
    "serve": "esbuild src/blokus.ts css/blokus.css --bundle --target=es2017 --format=esm --outdir=dist \"--entry-names=[name]\" --charset=utf8 --sourcemap --supported:nesting=false --servedir=dist",
    "test": "node --test test/*.test.ts"
  },
  "author": "irori",
  "license": "Unlicense",
  "repository": "github:irori/blokus",
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
